#!/usr/bin/env php
<?php

/**
 * Patches the generated build files before `zephir compile` runs.
 *
 * Zephir emits ext/config.m4 and ext/config.w32 from its own templates and has
 * no way to know this project needs OpenBLAS on Windows, an execinfo fallback on
 * musl, or an object directory for the hand-written C under ext/include. This
 * script adds those three things, idempotently, on every build.
 *
 * Every anchor it matches on is derived from config.json's extension-name rather
 * than spelled out. When this project was renamed from `tensor` to `tensor_ext`,
 * Zephir started emitting PHP_TENSOR_EXT and TENSOR_EXT_SHARED_LIBADD while the
 * hard-coded anchors here still said PHP_TENSOR and TENSOR_SHARED_LIBADD, so all
 * three patches stopped applying and `composer compile` exited 1 on the first of
 * them. CI never caught it because it builds through PIE from the committed
 * ext/ and never regenerates. tests/BuildExtTest.php now runs this for real.
 */

const CONFIG_M4_PATH = './ext/config.m4';
const CONFIG_W32_PATH = './ext/config.w32';
const CONFIG_JSON_PATH = './config.json';

chdir(__DIR__);

echo 'Reading config.json file... ';

$configJson = file_get_contents(CONFIG_JSON_PATH);

if (!$configJson) {
    fwrite(STDERR, "Failed to read the config.json file!\n");

    exit(1);
}

$config = json_decode($configJson, true);

if (!is_array($config)) {
    fwrite(STDERR, "Failed to parse the config.json file!\n");

    exit(1);
}

// Zephir names everything after extension-name, falling back to name.
$extension = (string) ($config['extension-name'] ?? $config['name'] ?? '');

if ($extension === '') {
    fwrite(STDERR, "config.json declares neither extension-name nor name!\n");

    exit(1);
}

$upper = strtoupper($extension);

$w32Guard = sprintf('if (PHP_%s != "no") {', $upper);
$libAddAnchor = sprintf('PHP_SUBST(%s_SHARED_LIBADD)', $upper);

echo "done.\n";

echo 'Reading config.w32 file... ';

$configW32Contents = file_get_contents(CONFIG_W32_PATH);

if ($configW32Contents === false) {
    fwrite(STDERR, "Failed to read the config.w32 file!\n");

    exit(1);
}

echo "done.\n";

echo 'Applying OpenBLAS patch... ';

if (strpos($configW32Contents, 'CHECK_LIB("libopenblas.lib"') !== false) {
    echo "already applied.\n";
} else {
    $openblasPatch = sprintf(
        <<<'EOT'
        if (PHP_%1$s != "no") {
          if (!CHECK_LIB("libopenblas.lib", "%2$s", PHP_%1$s) ||
              !CHECK_HEADER_ADD_INCLUDE("cblas.h", "CFLAGS_%1$s")) {
            ERROR("%2$s requires OpenBLAS libraries and headers");
          }
        EOT,
        $upper,
        $extension
    );

    $lineEnding = strpos($configW32Contents, "\r\n") !== false ? "\r\n" : "\n";
    $openblasPatch = str_replace("\n", $lineEnding, $openblasPatch);

    $configW32Contents = str_replace($w32Guard, $openblasPatch, $configW32Contents, $count);

    if ($count !== 1) {
        fwrite(STDERR, sprintf("Expected exactly one '%s' in config.w32, found %d!\n", $w32Guard, $count));

        exit(1);
    }

    if (file_put_contents(CONFIG_W32_PATH, $configW32Contents) === false) {
        fwrite(STDERR, "Failed to patch OpenBLAS support into config.w32!\n");

        exit(1);
    }

    echo "done.\n";
}

echo 'Reading config.m4 file... ';

$configM4Contents = file_get_contents(CONFIG_M4_PATH);

if (!$configM4Contents) {
    fwrite(STDERR, "Failed to read the config.m4 file!\n");

    exit(1);
}

echo "done.\n";

if (strpos($configM4Contents, $libAddAnchor) === false) {
    fwrite(STDERR, sprintf("Patch entrypoint '%s' not found in config.m4!\n", $libAddAnchor));

    exit(1);
}

echo 'Applying libexec patch... ';

$execinfoMatch = $libAddAnchor . "\n";
$execinfoPatch = <<<'EOT'

	AC_CANONICAL_BUILD
	if test "$build_os" = linux-musl; then
		CPPFLAGS="${CPPFLAGS:-} -DALPINE_LINUX"
	else
		AC_CHECK_FUNC(backtrace_symbols, have_backtrace_symbols=yes, have_backtrace_symbols=no)
		if test $have_backtrace_symbols = no; then
			LDFLAGS="${LDFLAGS:-} -lexecinfo"
		fi
	fi

EOT;

if (strpos($configM4Contents, trim($execinfoPatch)) !== false) {
    echo "already applied.\n";
} else {
    $configM4Contents = str_replace($execinfoMatch, $execinfoMatch . $execinfoPatch, $configM4Contents);

    echo "done.\n";
}

echo 'Applying build directories patch... ';

$extraSources = $config['extra-sources'] ?? [];

$buildDirs = [];

if (is_array($extraSources)) {
    foreach ($extraSources as $source) {
        $dir = dirname((string) $source);

        if ($dir !== '.' && $dir !== '' && !in_array($dir, $buildDirs, true)) {
            $buildDirs[] = $dir;
        }
    }
}

if (!$buildDirs) {
    echo "no extra source directories.\n";
} else {
    $patched = false;

    foreach ($buildDirs as $dir) {
        $entry = 'PHP_ADD_BUILD_DIR([$ext_builddir/' . $dir . '])';

        if (strpos($configM4Contents, $entry) !== false) {
            continue;
        }

        // Zephir derives build directories from the .zep.c files it generates
        // and never from extra-sources, so ext/include would otherwise have no
        // object directory of its own.
        $configM4Contents = str_replace(
            $libAddAnchor,
            $entry . "\n\t" . $libAddAnchor,
            $configM4Contents
        );

        $patched = true;
    }

    echo $patched ? "done.\n" : "already applied.\n";
}

echo 'Saving config.m4 file... ';

if (file_put_contents(CONFIG_M4_PATH, $configM4Contents) === false) {
    fwrite(STDERR, "Failed to write the config.m4 file\n");

    exit(1);
}

echo "done.\n";
